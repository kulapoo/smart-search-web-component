{
  "name": "smart-search-web-component",
  "version": "0.1.0",
  "description": "A framework-agnostic smart search input built on Web Components with filter chips, keyboard navigation, and custom renderers.",
  "type": "module",
  "main": "./dist/smart-search.umd.js",
  "module": "./dist/smart-search.es.js",
  "types": "./dist/smart-search.d.ts",
  "exports": {
    ".": {
      "types": "./dist/smart-search.d.ts",
      "import": "./dist/smart-search.es.js",
      "require": "./dist/smart-search.umd.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "prepublishOnly": "npm run test && npm run build"
  },
  "keywords": [
    "web-component",
    "custom-element",
    "search",
    "smart-search",
    "autocomplete",
    "typeahead",
    "dropdown",
    "filter",
    "shadow-dom"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@floating-ui/dom": "^1.0.0",
    "lucide": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@floating-ui/dom": "^1.7.6",
    "@types/node": "^25.5.0",
    "eslint": "^10.1.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "lucide": "^1.7.0",
    "prettier": "3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.2"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
}
